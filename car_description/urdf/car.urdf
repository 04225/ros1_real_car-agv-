<?xml version="1.0" ?>
<robot name="car">
        <link name="base_footprint">
            <visual>
                <origin  xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.1" length="0.05"/>
                </geometry>
                <material name="yellow">
                <color rgba="1 0 0 1"/>
                </material>
            </visual>
        </link>
        

        <joint name="base_left_motor_joint" type="fixed">
            <origin xyz="0.04  -0.05  0.0" rpy="0.0 0.0 0.0"/>
            <parent link="base_footprint"/>
            <child link="left_motor"/>
        </joint>

        <link name="left_motor">
            <visual>
                <origin  xyz="0.0 0.0 0.0" rpy="1.5707  0.0  0.0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.11"/>
                </geometry>
                <material name="gray">
                    <color rgba="0.75  0.75  0.75  1"/>
                </material>
            </visual>
        </link>

        <joint name="left_wheel_joint" type="continuous">
            <origin  xyz="0.0 0.16 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="left_motor"/>
            <child link="left_wheel_link"/>
            <axis xyz="0.0   1  0.0"/>
        </joint>

        <link name="left_wheel_link">
            <visual>
                <origin  xyz="0.0 0.0 0.0" rpy="1.5707 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.04" length="0.03"/>
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 0.9"/>
                </material>
            </visual>
        </link>


        <joint name="base_right_motor_joint" type="fixed">
            <origin  xyz="0.04  0.05  0.0" rpy="0.0 0.0 0.0"/>
            <parent link="base_footprint"/>
            <child link="right_motor"/>
        </joint>

       <link name="right_motor">
           <visual>
               <origin xyz="0.0 0.0 0.0" rpy="-1.5707  0.0  0.0"/>
               <geometry>
                   <cylinder radius="0.02" length="0.11"/>
               </geometry>
               <material name="gray">
                   <color rgba="0.75  0.75  0.75  1"/>
               </material>
           </visual>
       </link>


       <joint name="right_wheel_joint" type="continuous">
           <origin  xyz="0.0 -0.16 0.0" rpy="0.0 0.0 0.0"/>
           <parent link="right_motor"/>
           <child link="right_wheel_link"/>
           <axis xyz="0.0 1.0 0.0"/>
       </joint>

       <link name="right_wheel_link">
           <visual>
               <origin xyz="0.0 0.0 0.0" rpy="-1.5707 0.0 0.0"/>
               <geometry>
                   <cylinder radius="0.04" length="0.03"/>
               </geometry>
               <material name="white">
                   <color rgba="1.0 1.0 1.0 0.9"/>
               </material>
           </visual>
       </link>
       
       <joint name="front_wheel_joint" type="fixed">
           <origin  xyz="0.08 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <parent link="base_footprint"/>
           <child link="front_wheel_link"/>
       </joint>

       <link name="front_wheel_link">
           <visual>
               <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
               <geometry>
                       <sphere radius="0.035"/>
                   </geometry>
                   <material name="black">
                       <color rgba="0 0.0 0.0 0.95"/>
                   </material>
           </visual>
       </link>

       <joint name="back_wheel_joint" type="fixed">
           <origin  xyz="-0.08 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <parent link="base_footprint"/>
           <child link="back_wheel_link"/>
       </joint>

       <link name="back_wheel_link">
           <visual>
               <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
               <geometry>
                   <sphere radius="0.035"/>
               </geometry>
               <material name="black">
                   <color rgba="0.0 0.0 0.0 0.9"/>
               </material>
           </visual>
       </link>
</robot>
